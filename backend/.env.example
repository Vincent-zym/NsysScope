NSYSSCOPE_DATA_DIR=/home/user/nsysscope-data
NSYSSCOPE_ALLOWED_ROOTS=/home/user
NSYSSCOPE_API_TOKEN=replace-with-a-long-random-token
NSYSSCOPE_CORS_ORIGINS=http://localhost:3000,https://nsysscope-perf.z-yuanming.chatgpt.site
NSYSSCOPE_MAX_WORKERS=1
NSYSSCOPE_CODEX_ENABLED=false
NSYSSCOPE_CODEX_BIN=codex
NSYSSCOPE_COMATE_ENABLED=false
NSYSSCOPE_COMATE_BIN=/path/to/zulu
NSYSSCOPE_COMATE_USERNAME=
NSYSSCOPE_COMATE_MODEL=
NSYSSCOPE_COMATE_PLATFORM=internal
NSYSSCOPE_COMATE_TIMEOUT_SECONDS=7200
NSYSSCOPE_AGENT_HEARTBEAT_SECONDS=30
NSYSSCOPE_JOB_LOG_MAX_BYTES=8388608
NSYSSCOPE_JOB_LOG_LINE_MAX_BYTES=16384
NSYSSCOPE_NSYS_BIN=nsys
NSYSSCOPE_SKILL_DIR=/root/.codex/skills/sglang-nsys-static-analysis
