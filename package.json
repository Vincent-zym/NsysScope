{
  "name": "nsysscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/build_in_temp.sh",
    "build:site": "vinext build && node scripts/prepare_sites_dist.mjs",
    "build:local": "vite build --config vite.local.config.mjs",
    "watch:local": "vite build --config vite.local.config.mjs --watch",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "tool": "bash ./nsysscope start",
    "analyzer": "bash backend/run.sh",
    "test:backend": "pytest -q backend/test_service.py"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-rsc": "^0.5.32",
    "vinext": "^1.0.0-beta.4"
  }
}
