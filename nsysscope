#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-start}"
RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp}"
CACHE_BASE="${XDG_CACHE_HOME:-${HOME}/.cache}/nsysscope"
STATE_BASE="${XDG_STATE_HOME:-${HOME}/.local/state}/nsysscope"
VENV_DIR="${NSYSSCOPE_VENV_DIR:-$CACHE_BASE/venv}"
DATA_DIR=""
SKILL_DIR="${NSYSSCOPE_SKILL_DIR:-}"
SKILL_MANAGER="$PROJECT_DIR/scripts/skill_manager.py"
ALLOWED_ROOTS="${NSYSSCOPE_ALLOWED_ROOTS:-$(dirname "$PROJECT_DIR")}"
ANALYZER_PID=""
RUNTIME_DIR=""
DATA_DIR_OWNED=false
PERSIST_STATE="${NSYSSCOPE_PERSIST_STATE:-false}"
PERSIST_DATA_DIR="${NSYSSCOPE_DATA_DIR:-$STATE_BASE}"
CODEX_READY=false
COMATE_BIN="${NSYSSCOPE_COMATE_BIN:-}"
COMATE_PLATFORM="${NSYSSCOPE_COMATE_PLATFORM:-internal}"
# The Comate Zulu CLI is a modern-JS bundle: on Node <= 12 it dies while loading and
# still exits 0, so "node exists" is not a sufficient check. Keep this in step with
# MIN_NODE_MAJOR in backend/runner.py.
MIN_NODE_MAJOR="${NSYSSCOPE_MIN_NODE_MAJOR:-18}"

say() {
  printf '[NsysScope] %s\n' "$*"
}

fail() {
  printf '[NsysScope] ERROR: %s\n' "$*" >&2
  exit 1
}

DOWNLOAD_PROXY=""
DOWNLOAD_PROXY_PROBED=false

# Candidate ways out to the public internet, best first: whatever the caller
# already exported, then the two office proxies. None of this is used unless a
# direct connection fails.
proxy_candidates() {
  if [[ -n "${NSYSSCOPE_DOWNLOAD_PROXY:-}" ]]; then
    printf '%s\n' "$NSYSSCOPE_DOWNLOAD_PROXY"
    return
  fi
  printf '%s\n' "${https_proxy:-}" "${HTTPS_PROXY:-}" \
    "http://agent.baidu.com:8891" "http://10.162.37.16:8128"
}

# Decide once how to reach PyPI / nodejs.org. Only the download steps use the
# result: the agent CLIs must run with no proxy variables at all, so this is
# deliberately never exported into the shell.
probe_download_proxy() {
  [[ "$DOWNLOAD_PROXY_PROBED" == true ]] && return 0
  DOWNLOAD_PROXY_PROBED=true
  # HEAD, not GET: https://pypi.org/simple/ is a ~45MB index page, and a GET that
  # gets truncated by --max-time looks exactly like an unreachable proxy.
  local probe_url="${NSYSSCOPE_PROXY_PROBE_URL:-https://pypi.org/simple/}"
  if curl --head --noproxy '*' -fsS -o /dev/null --connect-timeout 5 --max-time 15 "$probe_url" 2>/dev/null; then
    say "外网可直连，下载依赖不使用代理"
    return 0
  fi
  local candidate
  while read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if curl --head -x "$candidate" -fsS -o /dev/null --connect-timeout 5 --max-time 15 "$probe_url" 2>/dev/null; then
      DOWNLOAD_PROXY="$candidate"
      say "下载依赖将通过代理：$candidate"
      return 0
    fi
  done < <(proxy_candidates)
  say "未找到可用的外网通路；如需指定代理请设置 NSYSSCOPE_DOWNLOAD_PROXY"
  return 1
}

# Run one download command against the official index. A user-level pip.conf
# pointing at an internal mirror is ignored on purpose: this tool is installed
# from upstream releases and the mirror lags behind them.
run_download() {
  local -a proxy_env=()
  if [[ -n "$DOWNLOAD_PROXY" ]]; then
    proxy_env=(
      "http_proxy=$DOWNLOAD_PROXY" "https_proxy=$DOWNLOAD_PROXY"
      "HTTP_PROXY=$DOWNLOAD_PROXY" "HTTPS_PROXY=$DOWNLOAD_PROXY"
    )
  fi
  env -u PIP_TRUSTED_HOST -u PIP_EXTRA_INDEX_URL \
    PIP_CONFIG_FILE=/dev/null \
    PIP_INDEX_URL="${NSYSSCOPE_PIP_INDEX_URL:-https://pypi.org/simple}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ${proxy_env[@]+"${proxy_env[@]}"} "$@"
}

cleanup() {
  if [[ -n "${ANALYZER_PID:-}" ]]; then
    say "正在关闭 Analyzer"
    kill "$ANALYZER_PID" >/dev/null 2>&1 || true
    wait "$ANALYZER_PID" 2>/dev/null || true
    ANALYZER_PID=""
  fi
  if [[ -n "${RUNTIME_DIR:-}" ]] && [[ -d "$RUNTIME_DIR" ]]; then
    rm -rf -- "$RUNTIME_DIR"
    RUNTIME_DIR=""
  fi
  if [[ "$DATA_DIR_OWNED" == true ]] && [[ -n "${DATA_DIR:-}" ]] && [[ -d "$DATA_DIR" ]]; then
    rm -rf -- "$DATA_DIR"
    DATA_DIR=""
  fi
}

find_port() {
  python3 - "$1" <<'PY'
import socket
import sys

start = int(sys.argv[1])
for port in range(start, start + 100):
    with socket.socket() as sock:
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            continue
    print(port)
    raise SystemExit(0)
raise SystemExit(f"no free port in {start}..{start + 99}")
PY
}

try_install_node_pkgmgr() {
  local installed=1
  # The distro mirror may itself need the proxy, and sudo drops the environment
  # unless told to keep it, so both paths go through run_download.
  probe_download_proxy || true
  if command -v apt-get >/dev/null 2>&1; then
    if [[ "$(id -u)" -eq 0 ]]; then
      run_download apt-get update -qq && run_download apt-get install -y -qq nodejs npm
    elif command -v sudo >/dev/null 2>&1; then
      run_download sudo -E apt-get update -qq \
        && run_download sudo -E apt-get install -y -qq nodejs npm
    else
      return 1
    fi
    installed=$?
  elif command -v dnf >/dev/null 2>&1; then
    if [[ "$(id -u)" -eq 0 ]]; then
      run_download dnf install -y -q nodejs npm
    elif command -v sudo >/dev/null 2>&1; then
      run_download sudo -E dnf install -y -q nodejs npm
    else
      return 1
    fi
    installed=$?
  elif command -v yum >/dev/null 2>&1; then
    if [[ "$(id -u)" -eq 0 ]]; then
      run_download yum install -y -q nodejs npm
    elif command -v sudo >/dev/null 2>&1; then
      run_download sudo -E yum install -y -q nodejs npm
    else
      return 1
    fi
    installed=$?
  else
    return 1
  fi
  [[ "$installed" -eq 0 ]]
}

try_install_node_binary() {
  local arch os_arch node_version download_url install_dir tmp_dir
  case "$(uname -m)" in
    x86_64) os_arch="x64" ;;
    aarch64|arm64) os_arch="arm64" ;;
    *) return 1 ;;
  esac
  case "$(uname -s)" in
    Linux) arch="linux" ;;
    Darwin) arch="darwin" ;;
    *) return 1 ;;
  esac
  node_version="${NSYSSCOPE_NODE_VERSION:-v20.17.0}"
  download_url="https://nodejs.org/dist/${node_version}/node-${node_version}-${arch}-${os_arch}.tar.xz"
  install_dir="${NSYSSCOPE_NODE_DIR:-$CACHE_BASE/node}"
  # A previous run already put a private node here; reuse it instead of downloading
  # the same tarball again on every start.
  if [[ -x "$install_dir/bin/node" ]]; then
    export PATH="$install_dir/bin:$PATH"
    if node_ready; then
      return 0
    fi
  fi
  printf '    尝试直接下载 Node.js 二进制包: %s\n' "$download_url"
  probe_download_proxy || true
  tmp_dir="$(mktemp -d)"
  # No --max-time: a 25 MB tarball over a slow office line legitimately takes
  # minutes. --speed-time/--speed-limit aborts a stalled transfer instead.
  if ! run_download curl -fsSL --connect-timeout 15 \
    --speed-time 60 --speed-limit 1024 -o "$tmp_dir/node.tar.xz" "$download_url"; then
    rm -rf -- "$tmp_dir"
    return 1
  fi
  mkdir -p "$install_dir"
  if ! tar -xf "$tmp_dir/node.tar.xz" -C "$install_dir" --strip-components=1; then
    rm -rf -- "$tmp_dir"
    return 1
  fi
  rm -rf -- "$tmp_dir"
  export PATH="$install_dir/bin:$PATH"
  [[ -x "$install_dir/bin/node" ]]
}

node_major() {
  local raw
  command -v node >/dev/null 2>&1 || return 1
  raw="$(node --version 2>/dev/null)" || return 1
  raw="${raw#v}"
  raw="${raw%%.*}"
  [[ "$raw" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$raw"
}

node_ready() {
  local major
  major="$(node_major)" || return 1
  [[ "$major" -ge "$MIN_NODE_MAJOR" ]]
}

try_install_node() {
  local major
  if node_ready; then
    return 0
  fi
  if major="$(node_major)"; then
    # An old node already on PATH is the case that used to slip through: the CLI
    # crashed with "Error: Not supported" and still exited 0, so the job failed
    # much later on missing tables. Install a private new-enough node in front of
    # it rather than touching the system one other tooling may depend on.
    printf '    检测到 Node.js 版本过低（v%s，需要 %s 及以上），尝试安装新版本...\n' \
      "$major" "$MIN_NODE_MAJOR"
    if try_install_node_binary && node_ready; then
      printf '    ✓ Node.js 已就绪: %s (%s)\n' "$(command -v node)" "$(node --version)"
      return 0
    fi
    return 1
  fi
  printf '    检测到缺少 Node.js，尝试自动安装...\n'
  if try_install_node_pkgmgr && node_ready; then
    printf '    ✓ Node.js 安装成功: %s (%s)\n' "$(command -v node)" "$(node --version)"
    return 0
  fi
  printf '    包管理器安装失败、不可用或版本过低，尝试从 nodejs.org 下载二进制包...\n'
  if try_install_node_binary && node_ready; then
    printf '    ✓ Node.js 安装成功: %s (%s)\n' "$(command -v node)" "$(node --version)"
    return 0
  fi
  return 1
}

discover_zulu() {
  if [[ -n "$COMATE_BIN" ]] && [[ -x "$COMATE_BIN" ]]; then
    printf '%s\n' "$COMATE_BIN"
    return
  fi
  local search_root="${HOME}/.comate-server/bin"
  [[ -d "$search_root" ]] || return 0
  find "$search_root" \
    -path '*/extensions/baiducomate.comate/dist/zulu-cli/bin/zulu' \
    -type f -perm -111 2>/dev/null | sort | tail -1 || return 0
}

bounded() {
  # Wrap a probe that talks to the network. Both agent CLIs can hang on a dead
  # endpoint, and `doctor` runs before every `start`, so an unbounded probe means an
  # unbootable tool. `timeout` is coreutils and always present in practice; without
  # it, run the probe unwrapped rather than refusing to check.
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@"
  else
    "$@"
  fi
}

run_comate_cli() {
  if [[ "$COMATE_PLATFORM" == "internal" ]]; then
    env -u HTTPS_PROXY -u HTTP_PROXY -u https_proxy -u http_proxy \
      -u ALL_PROXY -u all_proxy PLATFORM=internal "$COMATE_BIN" "$@"
  else
    env PLATFORM=saas "$COMATE_BIN" "$@"
  fi
}

comate_status_probe() {
  # `status` is a network call, so it gets a deadline -- unlike `login`, which is
  # interactive and must be allowed to wait for the user. `timeout` cannot run a
  # shell function, so the deadline is applied to `env` and the CLI directly.
  if [[ "$COMATE_PLATFORM" == "internal" ]]; then
    bounded 20 env -u HTTPS_PROXY -u HTTP_PROXY -u https_proxy -u http_proxy \
      -u ALL_PROXY -u all_proxy PLATFORM=internal "$COMATE_BIN" status
  else
    bounded 20 env PLATFORM=saas "$COMATE_BIN" status
  fi
}

resolve_skill() {
  if [[ -z "$SKILL_DIR" ]]; then
    SKILL_DIR="$(python3 "$SKILL_MANAGER" resolve)"
  fi
}

doctor() {
  local failed=0 provider_ready=0 comate_status comate_status_code
  say "检查运行环境"
  for command_name in python3 curl flock sha256sum awk tar mktemp find; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf '  ✓ %-9s %s\n' "$command_name" "$(command -v "$command_name")"
    else
      printf '  ✗ %s\n' "$command_name"
      failed=1
    fi
  done
  # 3.10 is the verified floor: below it pydantic cannot evaluate the `str | None`
  # annotations in backend/models.py, which fails at import rather than at use.
  if command -v python3 >/dev/null 2>&1; then
    if python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
      printf '  ✓ %-9s %s\n' "python>=3.10" "$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
    else
      printf '  ✗ python3 版本过低（需要 3.10 及以上，当前 %s）\n' \
        "$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
      failed=1
    fi
  fi
  if command -v nsys >/dev/null 2>&1; then
    printf '  ✓ %-9s %s\n' "nsys" "$(command -v nsys)"
  else
    printf '  - nsys 未安装；仍可导入已有七表包，不能分析 .nsys-rep\n'
  fi
  if command -v codex >/dev/null 2>&1 && bounded 20 codex login status >/dev/null 2>&1; then
    printf '  ✓ Codex 已登录\n'
    CODEX_READY=true
    provider_ready=1
  elif command -v codex >/dev/null 2>&1; then
    printf '  △ Codex 已安装但尚未登录，请运行 codex login\n'
  else
    printf '  - Codex CLI 未安装\n'
  fi
  COMATE_BIN="$(discover_zulu)"
  if [[ -n "$COMATE_BIN" ]]; then
    # Check the runtime before asking the CLI anything: an old node makes zulu die
    # while loading yet still exit 0, so "status" would report success.
    if ! node_ready; then
      if node_major >/dev/null 2>&1; then
        printf '  △ Comate Zulu 需要 Node %s 及以上，当前 %s\n' \
          "$MIN_NODE_MAJOR" "$(node --version)"
      else
        printf '  △ Comate Zulu 需要 Node.js 运行时，但未检测到 node\n'
      fi
      if ! try_install_node; then
        printf '    自动安装失败，请手动安装 Node.js %s+ 后重新运行: ./nsysscope doctor\n' \
          "$MIN_NODE_MAJOR"
        printf '    Debian/Ubuntu: sudo apt install -y nodejs npm\n'
      fi
    fi
    set +e
    comate_status="$(comate_status_probe 2>&1)"
    comate_status_code=$?
    set -e
    if [[ "$comate_status_code" -eq 0 ]] \
      && [[ "$comate_status" != *"未登录"* ]] \
      && [[ "$comate_status" != *"not logged"* ]] \
      && [[ "$comate_status" != *"Error: Not supported"* ]]; then
      printf '  ✓ Comate Zulu 已登录\n'
      provider_ready=1
    elif [[ "$comate_status" == *"Error: Not supported"* ]]; then
      printf '  ✗ Comate Zulu 启动即崩溃（Error: Not supported），Node 运行时不兼容\n'
      printf '    当前 node: %s；需要 Node %s 及以上\n' \
        "$(node --version 2>/dev/null || echo '未检测到')" "$MIN_NODE_MAJOR"
      failed=1
    elif [[ "$comate_status" == *"未登录"* ]] || [[ "$comate_status" == *"not logged"* ]]; then
      printf '  △ Comate Zulu 已安装但尚未登录\n'
      printf '    运行: ./nsysscope login comate\n'
    elif [[ "$comate_status" == *"env: "*"node"*"No such file or directory"* ]]; then
      printf '  △ Comate Zulu 需要 Node.js 运行时，但未检测到 node\n'
      if try_install_node; then
        set +e
        comate_status="$(comate_status_probe 2>&1)"
        comate_status_code=$?
        set -e
        if [[ "$comate_status_code" -eq 0 ]] \
          && [[ "$comate_status" != *"未登录"* ]] \
          && [[ "$comate_status" != *"not logged"* ]]; then
          printf '  ✓ Comate Zulu 已登录\n'
          provider_ready=1
        elif [[ "$comate_status" == *"未登录"* ]] || [[ "$comate_status" == *"not logged"* ]]; then
          printf '  △ Comate Zulu 已安装但尚未登录\n'
          printf '    运行: ./nsysscope login comate\n'
        else
          printf '  △ Node.js 已安装，但 Comate Zulu 状态检查仍失败\n'
          [[ -z "$comate_status" ]] || printf '    %s\n' "$comate_status"
        fi
      else
        printf '    请手动安装 Node.js 后重新运行: ./nsysscope doctor\n'
        printf '    Debian/Ubuntu: sudo apt install -y nodejs npm\n'
      fi
    else
      printf '  △ Comate Zulu 状态检查失败\n'
      [[ -z "$comate_status" ]] || printf '    %s\n' "$comate_status"
    fi
  else
    printf '  - Comate Zulu CLI 未安装\n'
  fi
  if ! resolve_skill; then
    printf '  ✗ Skill     无法解析\n'
    failed=1
  elif [[ -f "$SKILL_DIR/SKILL.md" ]]; then
    printf '  ✓ Skill     %s\n' "$SKILL_DIR"
  else
    printf '  ✗ Skill     未找到 %s/SKILL.md\n' "$SKILL_DIR"
    failed=1
  fi
  if [[ "$failed" -ne 0 ]]; then
    fail "环境检查未通过"
  fi
  if [[ "$provider_ready" -eq 0 ]]; then
    printf '  - Codex 和 Comate 均不可用；仍可导入已有七表包\n'
  fi
  say "环境检查通过"
}

venv_ready() {
  # `bin/uvicorn` exists as soon as pip starts unpacking, so its presence is not
  # evidence of a complete install. Importing what the Analyzer imports at boot is.
  [[ -x "$VENV_DIR/bin/python3" ]] || return 1
  "$VENV_DIR/bin/python3" - <<'PY' >/dev/null 2>&1
import importlib
for module in ("fastapi", "uvicorn", "pydantic"):
    importlib.import_module(module)
PY
}

prepare_python() {
  if [[ ! -x "$VENV_DIR/bin/python3" ]]; then
    say "首次运行：创建 Python 虚拟环境"
    mkdir -p "$(dirname "$VENV_DIR")"
    python3 -m venv "$VENV_DIR"
  fi
  local requirements_hash
  requirements_hash="$(sha256sum "$PROJECT_DIR/backend/requirements.txt" | awk '{print $1}')"
  local stamp="$VENV_DIR/.nsysscope-requirements.sha256"
  local installed_hash=""
  [[ -f "$stamp" ]] && installed_hash="$(<"$stamp")"
  # An interrupted first install used to be grandfathered in by the stamp and then
  # never repaired, so every later run failed on a missing import. Reinstall
  # whenever the venv cannot import the Analyzer's dependencies, whatever the
  # stamp says; the stamp alone only guards against a requirements change.
  if venv_ready; then
    if [[ -z "$installed_hash" ]]; then
      printf '%s\n' "$requirements_hash" > "$stamp"
      return
    fi
    [[ "$installed_hash" == "$requirements_hash" ]] && return
  fi
  say "安装 Analyzer Python 依赖"
  rm -f "$stamp"
  probe_download_proxy || true
  run_download "$VENV_DIR/bin/python3" -m pip install \
    -r "$PROJECT_DIR/backend/requirements.txt" \
    || fail "依赖安装失败；确认能访问 https://pypi.org 或设置 NSYSSCOPE_DOWNLOAD_PROXY=<代理地址>，内网机器可改用 NSYSSCOPE_PIP_INDEX_URL=<内网 PyPI 源>"
  venv_ready || fail "依赖安装后仍无法导入 Analyzer 依赖，请删除 $VENV_DIR 后重试"
  printf '%s\n' "$requirements_hash" > "$stamp"
}

start() {
  cd "$PROJECT_DIR"
  doctor
  mkdir -p "$RUNTIME_BASE"
  exec 9>"$RUNTIME_BASE/nsysscope-${UID}.lock"
  flock -n 9 || fail "已有一个 NsysScope 实例正在运行"
  if [[ "$PERSIST_STATE" == true ]]; then
    DATA_DIR="$PERSIST_DATA_DIR"
    mkdir -p "$DATA_DIR"
  else
    if [[ -n "${NSYSSCOPE_DATA_DIR:-}" ]]; then
      say "忽略旧的 NSYSSCOPE_DATA_DIR；运行状态默认使用临时目录"
      say "如确需保留任务索引，请设置 NSYSSCOPE_PERSIST_STATE=true"
    fi
    DATA_DIR="$(mktemp -d "$RUNTIME_BASE/nsysscope-${UID}.XXXXXX")"
    DATA_DIR_OWNED=true
  fi
  RUNTIME_DIR="$(mktemp -d "$DATA_DIR/runtime.XXXXXX")"
  trap cleanup EXIT
  prepare_python

  local ui_port
  ui_port="$(find_port "${NSYSSCOPE_UI_PORT:-3000}")"

  say "启动 NsysScope（端口 $ui_port）"
  env \
    NSYSSCOPE_DATA_DIR="$DATA_DIR" \
    NSYSSCOPE_ALLOWED_ROOTS="$ALLOWED_ROOTS" \
    NSYSSCOPE_API_TOKEN="" \
    NSYSSCOPE_CODEX_ENABLED="$CODEX_READY" \
    NSYSSCOPE_COMATE_ENABLED="$([[ -n "$COMATE_BIN" ]] && printf true || printf false)" \
    NSYSSCOPE_COMATE_BIN="$COMATE_BIN" \
    NSYSSCOPE_COMATE_PLATFORM="$COMATE_PLATFORM" \
    NSYSSCOPE_CORS_ORIGINS="http://127.0.0.1:$ui_port,http://localhost:$ui_port" \
    NSYSSCOPE_MAX_WORKERS="${NSYSSCOPE_MAX_WORKERS:-2}" \
    NSYSSCOPE_SKILL_DIR="$SKILL_DIR" \
    "$VENV_DIR/bin/uvicorn" backend.app:app \
      --host 127.0.0.1 --port "$ui_port" \
      --no-access-log >>"$RUNTIME_DIR/analyzer.log" 2>&1 &
  ANALYZER_PID=$!
  trap cleanup EXIT
  trap 'exit 130' INT TERM

  local ready=0
  for _ in {1..80}; do
    if curl --noproxy '*' --silent --fail \
      "http://127.0.0.1:$ui_port/api/health" >/dev/null 2>&1; then
      ready=1
      break
    fi
    if ! kill -0 "$ANALYZER_PID" >/dev/null 2>&1; then
      tail -40 "$RUNTIME_DIR/analyzer.log" >&2 || true
      fail "Analyzer 启动失败"
    fi
    sleep 0.1
  done
  if [[ "$ready" -ne 1 ]]; then
    # cleanup() removes RUNTIME_DIR on exit, so pointing the user at the log there
    # left them roughly eight seconds to read it. Print it and keep a copy.
    local kept="${TMPDIR:-/tmp}/nsysscope-analyzer-$$.log"
    cp -f "$RUNTIME_DIR/analyzer.log" "$kept" 2>/dev/null || kept=""
    tail -40 "$RUNTIME_DIR/analyzer.log" >&2 || true
    if [[ -n "$kept" ]]; then
      fail "Analyzer 健康检查超时，完整日志已保留在 $kept"
    fi
    fail "Analyzer 健康检查超时"
  fi

  printf '\n'
  say "启动完成"
  printf '  页面地址:  http://127.0.0.1:%s\n' "$ui_port"
  printf '  物料范围:  %s\n' "$ALLOWED_ROOTS"
  printf '  最大任务并发数: %s\n' "${NSYSSCOPE_MAX_WORKERS:-2}"
  if [[ "$DATA_DIR_OWNED" == true ]]; then
    printf '  任务状态:  %s（停止后自动清理）\n' "$DATA_DIR"
  else
    printf '  任务状态:  %s（持久保留）\n' "$DATA_DIR"
  fi
  printf '  运行日志:  %s/analyzer.log（停止后自动清理）\n' "$RUNTIME_DIR"
  printf '\n'
  local ssh_local_port=""
  if [[ -n "${SSH_TTY:-}" || -n "${SSH_CONNECTION:-}" || -n "${_P9K_SSH_TTY:-}" ]]; then
    ssh_local_port="${NSYSSCOPE_SSH_LOCAL_PORT:-$((ui_port + 10000))}"
    printf '  SSH 转发（远端 %s，本地 %s），请在本地电脑执行：\n' "$ui_port" "$ssh_local_port"
    printf '  ssh -N -L %s:127.0.0.1:%s <用户名>@<服务器地址>\n' "$ssh_local_port" "$ui_port"
    printf '  浏览器地址: http://127.0.0.1:%s\n' "$ssh_local_port"
  else
    printf '  如果通过 SSH 使用，请在本地电脑执行：\n'
    printf '  ssh -N -L %s:127.0.0.1:%s <用户名>@<服务器地址>\n' "$ui_port" "$ui_port"
  fi
  printf '\n'
  say "按 Ctrl-C 停止全部服务"

  wait "$ANALYZER_PID"
}

login_provider() {
  case "${2:-}" in
    codex)
      command -v codex >/dev/null 2>&1 || fail "找不到 Codex CLI"
      exec codex login
      ;;
    comate)
      COMATE_BIN="$(discover_zulu)"
      [[ -n "$COMATE_BIN" ]] || fail "找不到 Comate Zulu CLI"
      COMATE_PLATFORM="${3:-$COMATE_PLATFORM}"
      [[ "$COMATE_PLATFORM" == "internal" || "$COMATE_PLATFORM" == "saas" ]] \
        || fail "Comate 平台只能是 internal 或 saas"
      if [[ "$COMATE_PLATFORM" == "internal" ]]; then
        exec env -u HTTPS_PROXY -u HTTP_PROXY -u https_proxy -u http_proxy \
          -u ALL_PROXY -u all_proxy PLATFORM=internal "$COMATE_BIN" login \
          --platform internal --no-browser --verbose
      fi
      exec env PLATFORM=saas "$COMATE_BIN" login \
        --platform saas --no-browser --verbose
      ;;
    *)
      fail "请指定 Provider：./nsysscope login [codex|comate]；Comate 可追加 [internal|saas]"
      ;;
  esac
}

skill_command() {
  shift
  exec python3 "$SKILL_MANAGER" "$@"
}

case "$COMMAND" in
  start)
    start
    ;;
  doctor)
    doctor
    ;;
  login)
    login_provider "$@"
    ;;
  skill)
    skill_command "$@"
    ;;
  *)
    printf 'Usage: %s [start|doctor|login codex|login comate [internal|saas]|skill status|skill use PATH|skill sync|skill reset|skill validate [PATH]]\n' "$0" >&2
    exit 2
    ;;
esac
